# ==============================================================================
# SkyPulse Flight Tracker - Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 1. OpenSky Network API (High-Frequency ADS-B Global Transponder Feed)
# Register for a free account at: https://opensky-network.org/
# (Optional: If provided, unlocks 10x higher rate limits & 15,000+ live flights)
# ------------------------------------------------------------------------------
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
# Or OAuth2 Bearer Token:
# OPENSKY_TOKEN=

# ------------------------------------------------------------------------------
# 2. AirLabs API (Commercial Airline Schedules & Flight Route Database)
# Register for a free API key at: https://airlabs.co/
# (Optional: Enriches live flights with authentic commercial schedules & carriers)
# ------------------------------------------------------------------------------
AIRLABS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Google Gemini API (AI Copilot & Real-Time ATC Voice Intelligence)
# Get a free Gemini API key at: https://aistudio.google.com/
# (Optional: Enables AI route analysis, passenger briefings, and ATC copilot chat)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
